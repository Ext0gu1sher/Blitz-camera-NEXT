{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blitz Camera Pro source recipe v1",
  "type": "object", "additionalProperties": false,
  "required": ["format", "release", "source_root", "native_manifests", "evidence"],
  "properties": {
    "format": {"const": "blitz-camera-pro-source-v1"},
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_id", "version", "adapter_api", "host_min_version", "client", "entrypoints", "notes", "validation"],
      "properties": {
        "adapter_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 60},
        "adapter_api": {"const": 1},
        "host_min_version": {"type": "string", "description": "Minimum host, for example 0.9.6-beta"},
        "client": {
          "type": "object", "additionalProperties": false,
          "required": ["channel", "version", "sha256", "architecture"],
          "properties": {"channel": {"type": "string"}, "version": {"type": "string"},
                         "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "architecture": {"const": "x86"}}
        },
        "entrypoints": {"const": {"reader": "reader:CameraSession", "playback": "playback:PositionPlayback"}},
        "notes": {"type": "string", "maxLength": 4000},
        "validation": {
          "type": "object", "additionalProperties": false, "required": ["level", "summary"],
          "properties": {"level": {"enum": ["offline", "game"]}, "summary": {"type": "string", "minLength": 1, "maxLength": 1500}}
        }
      }
    },
    "source_root": {"type": "string", "description": "Relative to recipe, directory containing the fixed v1 Python modules and native/"},
    "native_manifests": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "description": "JSON/TXT/MD within the recipe directory"}}
  }
}
